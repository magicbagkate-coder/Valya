PORT=14000

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=replace-me
# Telegram IDs that can use the bot, separated by commas. The bot shows your ID when it refuses you.
TELEGRAM_ALLOWED_IDS=

# Claude (Anthropic)
ANTHROPIC_API_KEY=replace-me

# Google Sheets: the service account key file and the table id
GOOGLE_KEY_PATH=./google-key.json
SHEET_ID=replace-me

# Folder for the memory of the chats (the talk and the last report)
DATA_DIR=./data

# Chats that get the weekly analysis of the table (Wednesday, 09:00 Kyiv time). A group id is negative.
# If empty, every chat that talks with the bot gets it.
ANALYSIS_CHAT_IDS=

# Folder with the notes that the bot knows (.md and .txt files). The bot reads it at every answer.
KNOWLEDGE_DIR=./knowledge
