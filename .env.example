PORT=14000

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=replace-me
# Telegram IDs that can use the bot, separated by commas. The bot shows your ID when it refuses you.
TELEGRAM_ALLOWED_IDS=

# Claude (Anthropic)
ANTHROPIC_API_KEY=replace-me

# Google Sheets: the service account key file and the table id
GOOGLE_KEY_PATH=./google-key.json
SHEET_ID=replace-me

# Folder for the memory of the chats (the talk and the last report)
DATA_DIR=./data
