{
  "name": "agent",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main",
    "start:dev": "nest start --watch",
    "lint": "eslint -f ./tools/eslint-formatter.mjs .",
    "lint:fix": "eslint -f ./tools/eslint-formatter.mjs --fix .",
    "lint:docs": "vale docs",
    "test:lint": "node tools/fileNames.test.mjs && node tools/moduleBoundary.test.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run test:lint"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "dotenv": "^16.4.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^9.0.0",
    "@nestjs/cli": "^11.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "globals": "^17.13.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0"
  }
}
